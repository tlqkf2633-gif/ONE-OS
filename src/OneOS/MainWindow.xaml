<Window x:Class="OneOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="ONE OS" Width="1360" Height="850" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource DesktopBrush}">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition/><RowDefinition Height="88"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="Transparent" Padding="28,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="ONE OS" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="A calmer space to work" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
                <TextBlock x:Name="HeaderClock" DockPanel.Dock="Right" FontSize="13" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Canvas x:Name="DesktopCanvas" Grid.Row="1" ClipToBounds="True" />
        <Border Grid.Row="2" Background="Transparent" VerticalAlignment="Bottom" Margin="0,0,0,14">
            <Border x:Name="DockPanelBorder" HorizontalAlignment="Center" Background="{DynamicResource DockBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="28" Padding="10,7">
                <DockPanel LastChildFill="False">
                    <Button x:Name="LauncherButton" DockPanel.Dock="Left" Style="{StaticResource SoftButton}"
                            ToolTip="Applications" Click="ToggleLauncher">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18"/><TextBlock Text="  Apps" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <ItemsControl x:Name="DockItems" DockPanel.Dock="Left" Margin="10,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource SoftButton}" Padding="9,7" Margin="2,0"
                                    ToolTip="{Binding Name}" Click="DockItemClick" Tag="{Binding Id}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/>
                                    <Border Width="10" Height="3" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                            HorizontalAlignment="Center" Margin="0,3,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border DockPanel.Dock="Left" Width="1" Height="30" Background="{DynamicResource StrokeBrush}" Margin="4,0"/>
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0,6,0">
                        <TextBlock x:Name="DockTime" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DockDate" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Border>
        <Border x:Name="LauncherPanel" Grid.Row="1" Width="600" Height="430" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,20" Padding="24" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1" CornerRadius="28" Visibility="Collapsed" Panel.ZIndex="50">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,15">
                    <Button DockPanel.Dock="Right" Content="×" Click="CloseLauncher" Style="{StaticResource SoftButton}" Padding="10,4"/>
                    <StackPanel><TextBlock Text="Your apps" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Everything you need, in one place" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                </DockPanel>
                <TextBox x:Name="SearchBox" Grid.Row="1" Height="40" Margin="0,0,0,12" VerticalContentAlignment="Center"
                         ToolTip="Search apps" TextChanged="SearchBoxTextChanged" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LauncherItems">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource SoftButton}" Background="Transparent" Padding="10" Margin="3" Click="LaunchItemClick" Tag="{Binding Id}">
                                <StackPanel HorizontalAlignment="Center" Width="135">
                                    <Border Width="52" Height="52" CornerRadius="17" Background="{Binding Color}" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <DockPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Text="Windows manages your device and security" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Exit ONE OS" Click="ExitClick" Style="{StaticResource SoftButton}" Padding="10,5"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
