<Window x:Class="OneOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ONE OS" Width="1360" Height="850" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource DesktopBrush}"
        ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="Transparent" Padding="28,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="ONE OS" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="A calmer space to work" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderClock" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="MinimizeButton" Style="{StaticResource SoftButton}" Padding="8,5" Margin="1"
                            ToolTip="Minimize" AutomationProperties.Name="Minimize ONE OS" Click="MinimizeMainWindowClick">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource SoftButton}" Padding="8,5" Margin="1"
                            ToolTip="Maximize" AutomationProperties.Name="Maximize or restore ONE OS" Click="ToggleMainWindowStateClick">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                    <Button x:Name="CloseMainButton" Style="{StaticResource SoftButton}" Padding="8,5" Margin="1"
                            ToolTip="Close ONE OS" AutomationProperties.Name="Close ONE OS" Click="CloseMainWindowClick">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Canvas x:Name="DesktopCanvas" Grid.Row="1" ClipToBounds="True" />

        <!-- The dock overlays the desktop canvas and does not consume workspace height. -->
        <Border Grid.Row="1" Background="Transparent" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,14" Panel.ZIndex="100">
            <Border x:Name="DockPanelBorder" Background="{DynamicResource DockBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="24" Padding="7,5">
                <DockPanel LastChildFill="False">
                    <Button x:Name="LauncherButton" DockPanel.Dock="Left" Style="{StaticResource SoftButton}"
                            Padding="10,6" ToolTip="Applications" AutomationProperties.Name="Open application launcher" Click="ToggleLauncher">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16"/><TextBlock Text="  Apps" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <ItemsControl x:Name="DockItems" DockPanel.Dock="Left" Margin="7,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource SoftButton}" Padding="8,5" Margin="1,0"
                                    ToolTip="{Binding Name}" Click="DockItemClick" Tag="{Binding Id}"
                                    AutomationProperties.Name="{Binding Name}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                                    <Border Width="9" Height="2" CornerRadius="1" Background="{DynamicResource AccentBrush}"
                                            HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsOpen}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border DockPanel.Dock="Left" Width="1" Height="26" Background="{DynamicResource StrokeBrush}" Margin="4,0"/>
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="7,0,5,0">
                        <TextBlock x:Name="DockTime" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DockDate" FontSize="9" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Border>

        <Border x:Name="LauncherPanel" Grid.Row="1" Width="560" Height="410" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,76" Padding="20" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1" CornerRadius="24" Visibility="Collapsed" Panel.ZIndex="200">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="×" Click="CloseLauncher" Style="{StaticResource SoftButton}" Padding="9,3" ToolTip="Close launcher"/>
                    <StackPanel><TextBlock Text="Your apps" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Search and open an application" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/></StackPanel>
                </DockPanel>
                <TextBox x:Name="SearchBox" Grid.Row="1" Height="38" Margin="0,0,0,10" VerticalContentAlignment="Center"
                         ToolTip="Search applications" AutomationProperties.Name="Search applications" TextChanged="SearchBoxTextChanged" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LauncherItems">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource SoftButton}" Background="Transparent" Padding="8" Margin="2" Click="LaunchItemClick" Tag="{Binding Id}"
                                    AutomationProperties.Name="{Binding Name}">
                                <StackPanel HorizontalAlignment="Center" Width="130">
                                    <Border Width="48" Height="48" CornerRadius="15" Background="{Binding Color}" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <DockPanel Grid.Row="3" Margin="0,9,0,0">
                    <TextBlock Text="Windows manages your device and security" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Exit ONE OS" Click="ExitClick" Style="{StaticResource SoftButton}" Padding="9,4"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
